generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum AgentType {
  plan
  research
  code
  test
  docs
}

enum AgentStatus {
  pending
  running
  done
  error
}

model Project {
  id          String   @id @default(uuid())
  title       String?
  idea        String
  plan        String   @default("")
  research    String   @default("")
  code        String   @default("")
  test        String   @default("")
  docs        String   @default("")
  activeAgent String   @default("idle")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs        AgentRun[]
  artifacts   Artifact[]
  generatedFiles GeneratedFile[]
  logs        ActivityLog[]
}

model AgentRun {
  id          String      @id @default(uuid())
  projectId   String
  agent       AgentType
  status      AgentStatus @default(pending)

  input       Json
  output      String      @default("")
  summary     String      @default("")
  warnings    String[]    @default([])
  nextAction  String      @default("")
  usedMock    Boolean     @default(false)
  error       String?

  startedAt   DateTime    @default(now())
  finishedAt  DateTime?

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Artifact {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  type        String
  status      String   @default("draft")
  content     String   @default("")

  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model GeneratedFile {
  id          String   @id @default(uuid())
  projectId   String
  path        String
  content     String
  language    String   @default("text")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

model ActivityLog {
  id          String   @id @default(uuid())
  projectId   String
  message     String
  level       String   @default("info")

  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
